[
  { "function": "normalizeProjectDocument", "bindings": {
    "list": ["rawFloors"],
    "argSecondary": ["floorIndex"],
    "flag": ["originInitialized", "hasFloorGapSchema"],
    "text": ["rawFloorName"],
    "id": ["requestedActiveFloorId"],
    "found": ["activeFloorEntry"],
    "clampCurrent": ["baselineHeight"]
  } },
  { "function": "ensureTvScreenLayerNames", "bindings": {
    "argPrimary": ["items"],
    "value": ["layerNumber"]
  } },
  { "function": "ensureSmallCarChargingLayerNames", "bindings": {
    "argPrimary": ["items"],
    "value": ["layerNumber"]
  } },
  { "function": "getWallAnalysis", "bindings": {
    "argPrimary": ["thicknessMeters"],
    "value": ["sceneSignature"]
  } },
  { "function": "updateProgressChecklist", "bindings": {
    "value": ["stepState"],
    "layerKeys": ["nextStepKey"],
    "argPrimary": ["step"]
  } },
  { "function": "requestLightGroupCacheRefresh", "bindings": {
    "argPrimary": ["groupKeys"]
  } },
  { "function": "countMaterialTextures", "bindings": {
    "traverse": ["root"],
    "length": ["textureCount"],
    "material": ["node"],
    "conditionalValue": ["materials"],
    "localValue": ["materialEntry"]
  } },
  { "function": "buildFloorAcItemMeshGroup", "bindings": {
    "localValue": ["heightRatio"]
  } },
  { "function": "rebuildPreviewForAssetFilters", "bindings": {
    "argPrimary": ["assetScope"],
    "value": ["selectedLightGroup"]
  } },
  { "function": "beginItemDrag", "bindings": {
    "argPrimary": ["pointerPoint"],
    "value": ["handleHitRadius"],
    "controls": ["itemControls"]
  } },
  { "function": "placeCatalogItemAt", "bindings": {
    "argPrimary": ["planPoint"],
    "value": ["scalePixels"],
    "flag": ["isLightCategory"],
    "isStart": ["windowAttachment", "doorAttachment", "railingAttachment"],
    "maxValue": ["wallHitSlop"],
    "size": ["windowFixture", "doorFixture", "railingFixture"]
  } },
  { "function": "copySelectedItems", "bindings": {
    "list": ["copiedItems"],
    "argPrimary": ["selectedItem"],
    "id": ["floorEntry"]
  } },
  { "function": "onExportDimensionInput", "bindings": {
    "argPrimary": ["dimension"],
    "isWidth": ["typedValue"],
    "id": ["widthPx"],
    "argPrimaryCurrent": ["heightPx"]
  } },
  { "function": "normalizeProjectExportPresets", "bindings": {
    "list": ["presets"],
    "argSecondary": ["presetIndex"],
    "el": ["titleEl"],
    "elCurrent": ["statusEl"],
    "value": ["isActive"],
    "flag": ["presetIsEmpty"],
    "floor": ["floorRef", "activePreset"]
  } },
  { "function": "buildDesktopItemMeshGroup", "bindings": {
    "computedValue": ["screenWidth"],
    "value": ["screenHeight"]
  } }
]
